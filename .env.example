# CALLING 环境变量示例
# 复制本文件为 .env 并填写对应值

# 数据库连接（MySQL 格式）
DATABASE_URL=mysql://user:password@host:3306/calling

# JWT 签名密钥（随机字符串即可）
JWT_SECRET=your-random-secret-here

# LLM API（Manus 平台自动注入，迁移到其他平台时替换）
# Manus 平台：留空，平台自动注入 BUILT_IN_FORGE_API_KEY
# OpenAI：填写 https://api.openai.com
BUILT_IN_FORGE_API_URL=

# Manus 平台：留空，平台自动注入
# 其他平台：填写对应的 API Key（OpenAI / DeepSeek / Gemini 等）
BUILT_IN_FORGE_API_KEY=

# Web Push 通知（可选，不填则 Push 功能不工作）
# 生成命令：node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(JSON.stringify(k))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your@email.com
